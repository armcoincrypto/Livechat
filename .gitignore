# Exswaping backend overlay repository ignore rules.
# This checkout tracks a rates/analytics/deploy overlay inside a full Laravel tree.
# Runtime and bulk application paths must not re-enter git status as "source dirt".

# Secrets / local env (never commit)
.env
.env.*
!.env.example

# Editor / OS cruft
.DS_Store
**/.DS_Store
*.swp
*~

# PHPUnit / tooling caches
.phpunit.result.cache
.phpunit.cache/
.phpstan.cache/
.psalm/

# Composer / JS build artifacts
/vendor/
/node_modules/

# Laravel runtime
/storage/logs/
/storage/framework/
/storage/pail/
/bootstrap/cache/*.php
/public/hot
/public/storage
/public/static/exports/

# Backup / hotfix leftovers
*.bak
*.bak-*
*.bak.*
*.old
*.orig

# Audit artifacts generated under the app tree
/docs/audits/

# Large unrelated untracked app areas (tracked overlay files remain tracked)
/app/Ai/
/xml-changer/__pycache__/
*.pyc
resources/deploy/*.sha256

# Secrets / dumps / license blobs (never commit)
/database/*.sql
/iexexchanger_*
/iex-config.json
/iexexchanger_public.key
/storage/oauth-private.key
/storage/oauth-public.key
/storage/default_env.txt
/backups/
/exswaping-nginx-backups/
/probe_result.json
/hash.txt

# Protected overlay WIP copies (do not absorb into canonical source)
/Attribution*.php
/SessionAttribution.php
/AnalyticsAttributionDryRunCommand.php
/2026_08_06_222500_create_session_attributions_table.php
/{x[to]}/

/resources/admin-ops/pricing/node_modules/
