# Fast market plane (customer 30-60s freshness). All default false.
FAST_MARKET_PLANE_ENABLED=false
FAST_PUBLIC_QUOTE_ENABLED=false
FAST_ORDER_QUOTE_ENABLED=false
FAST_MARKET_SHADOW_ENABLED=false
# FAST_MARKET_FRESH_SECONDS=60
# FAST_MARKET_GRACE_SECONDS=120
# FAST_MARKET_EXPIRED_SECONDS=180
# FAST_MARKET_MAX_FALLBACK_RATE_AGE_SECONDS=1200
# FAST_MARKET_SNAPSHOT_REFRESH_SECONDS=30
# FAST_MARKET_QUOTE_TTL_SECONDS=60

# --- 30s producer / config-cache-safe (2026-10-27) ---
# All flags are read via config/fast_market.php (survives config:cache).
# Prefer systemd exswaping-fast-market-producer.service over everyMinute.
FAST_MARKET_PRODUCER_DAEMON=true
FAST_MARKET_SCHEDULER_FALLBACK=false
FAST_MARKET_SNAPSHOT_REFRESH_SECONDS=30
FAST_MARKET_FAILURE_BACKOFF_SECONDS=15
FAST_MARKET_FAILURE_BACKOFF_MAX_SECONDS=60
